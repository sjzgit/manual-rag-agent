# ---- 服务 ----
HOST=0.0.0.0
PORT=8001
DEBUG=false
CORS_ORIGINS=*

# ---- Milvus（现有外部服务） ----
MILVUS_HOST=192.168.0.215
MILVUS_PORT=19530
MILVUS_COLLECTION=manual_rag_chunks
# 混合检索 v2 collection（含稀疏向量字段）；旧库 manual_rag_child_chunks 保留作回滚
MILVUS_CHILD_COLLECTION=manual_rag_child_chunks_v2

# ---- Embedding ----
EMBED_MODEL_NAME=BAAI/bge-base-zh-v1.5
# 本地模型缓存离线加载（不联网校验）；首次下载新模型时临时设 false
HF_OFFLINE=true

# ---- 检索 ----
RETRIEVE_TOP_K=8
SCORE_THRESHOLD=0.4
RAG_MODE=generic

# ---- 关键词检索（BM25 稀疏向量，混合检索） ----
ENABLE_KEYWORD_SEARCH=true
BM25_K1=1.5
BM25_B=0.75
RECALL_TOP_K=20
FUSION_DENSE_WEIGHT=0.7
FUSION_SPARSE_WEIGHT=0.3
RRF_K=60
KEYWORD_PASS_RANK=3

# ---- 重排（SiliconFlow rerank；Key 留空则不重排，降级融合序） ----
RERANK_TOP_N=5
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=Qwen/Qwen3-Reranker-8B
RERANK_TIMEOUT=10

# ---- 数据文件（只读，请按实际路径填写） ----
CHUNKS_PATH=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/docs/文档切片/chunks.json
MEDIA_ROOT=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/docs/处理后的md手册文档

# ---- 上传目录（管理端写入源文档/转换md/提取图片，区别于只读知识库目录） ----
UPLOAD_ROOT=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/uploads

# ---- 主 LLM（DeepSeek，OpenAI 兼容可切换；Key 请自行填写） ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
# reasoning 模型思考过程计入 max_tokens；模型单次输出上限 393216，取最大值放开
LLM_MAX_TOKENS=393216

# ---- 意图识别小模型（OpenAI 兼容，独立配置；Key 待补充，留空则规则降级） ----
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=
INTENT_LLM_MODEL=
INTENT_LLM_TEMPERATURE=0.1
INTENT_LLM_MAX_TOKENS=1024

# ---- 澄清 ----
MAX_CLARIFY_ROUNDS=3

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=manual_rag

# ---- Redis（第5步，留空则不启用） ----
REDIS_URL=
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# ---- 会话记忆（关联手册优先检索） ----
# 开：先在会话关联手册内检索、分数不足自动全库；关：始终全库（记忆仍持续累积）
MEMORY_DIRECT_ANSWER=true
# 关联手册内检索结果的采用阈值（rerank 分量纲；低于该分数转全库检索）
MEMORY_DIRECT_SCORE_THRESHOLD=0.6

# ---- 管理端 ----
ADMIN_TOKEN=

# ---- MCP 服务（独立进程，python -m app.mcp；本地默认 8002，生产 compose 内 8002） ----
MCP_HOST=0.0.0.0
MCP_PORT=8002
MCP_PATH=/mcp
# 每请求独立传输，无会话亲和，适配多智能体并发
MCP_STATELESS=true
# 留空 = 不鉴权；非空时调用方需带 X-API-Key 或 Authorization: Bearer 头
MCP_API_KEY=
# 留空 = 来源切片图片保持 /api/images 相对路径；配置后改写为绝对 URL（如 http://192.168.0.215:8001）
MCP_PUBLIC_BASE_URL=
