# ---- 服务 ----
HOST=0.0.0.0
PORT=8000
DEBUG=false
CORS_ORIGINS=*

# ---- Milvus（现有外部服务） ----
MILVUS_HOST=192.168.0.215
MILVUS_PORT=19530
MILVUS_COLLECTION=manual_rag_chunks

# ---- Embedding ----
EMBED_MODEL_NAME=BAAI/bge-base-zh-v1.5

# ---- 检索 ----
RETRIEVE_TOP_K=2
SCORE_THRESHOLD=0.4
RAG_MODE=generic

# ---- 数据文件（只读，请按实际路径填写） ----
CHUNKS_PATH=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/docs/文档切片/chunks.json
META_DATA_PATH=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/docs/文档切片/meta_data.json
MEDIA_ROOT=F:/工作备忘录/修炼/叶小钗/AI-10/操作手册RAG/code/docs/处理后的md手册文档

# ---- 主 LLM（DeepSeek，OpenAI 兼容可切换；Key 请自行填写） ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ---- 意图识别小模型（OpenAI 兼容，独立配置；Key 待补充，留空则规则降级） ----
INTENT_LLM_API_KEY=
INTENT_LLM_BASE_URL=
INTENT_LLM_MODEL=
INTENT_LLM_TEMPERATURE=0.1
INTENT_LLM_MAX_TOKENS=1024

# ---- 澄清 ----
MAX_CLARIFY_ROUNDS=3

# ---- MySQL ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=manual_rag

# ---- Redis（第5步，留空则不启用） ----
REDIS_URL=
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=30

# ---- 管理端 ----
ADMIN_TOKEN=
